# ============================================================================
# CannTrace - Variables de Entorno
# ============================================================================
# Copiar este archivo como .env y completar con valores reales
# NUNCA commitear el .env con credenciales reales
# ============================================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- IA (Groq API) ---
# Se usa en Edge Functions, NO en el frontend
# GROQ_API_KEY=tu-groq-api-key
# GROQ_MODEL=llama-3.1-8b-instant

# --- Documenso (firma electronica - futuro) ---
# DOCUMENSO_API_URL=https://app.documenso.com/api/v1
# DOCUMENSO_API_KEY=tu-api-key

# --- App ---
VITE_APP_NAME=CannTrace
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development
